# Only app source, public documentation, and project metadata belong in Git.
/*
!/.gitignore
!/README.md
!/LICENSE
!/Android/
!/docs/
!/.github/

# Private research, legacy assets, and local workspace configuration
/Research/
/Android/app/src/main/assets/
.vscode/

# Local build state
.gradle/
.kotlin/
.idea/
*.iml
**/build/
local.properties
.gradle-user-home/

# OS/editor noise
.DS_Store
*.swp
*.swo

# Generated Android artifacts
*.apk
*.aab
*.apks
*.idsig

# Local device data and diagnostics
/capture/
/captures/
*.pcap
*.pcapng
*.pklg
*.btsnoop
*.hci
*.bfp
workspace.bin
*.log
*.tmp
*.tar.gz

# Signing and private keys
/.signing/
signing.properties
keystore.properties
/keystore/
*.jks
*.keystore
*.p12
*.pem
